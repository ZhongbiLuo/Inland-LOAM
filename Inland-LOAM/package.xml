<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inland_loam</name>
  <version>1.0.0</version>
  <description>Inland-waterway LiDAR odometry and structural semantic mapping for ROS 2.</description>

  <maintainer email="zhongbi.luo@kuleuven.be">Zhongbi Luo</maintainer>

  <author>Tixiao Shan</author>
  <author>Davide Faconti</author>
  <author>Eduardo Perdices</author>

  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>boost</depend>
  <depend>cloud_msgs</depend>
  <depend>eigen</depend>
  <depend>gtsam</depend>
  <depend>libpcl-all-dev</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>octomap_msgs</depend>
  <depend>octomap</depend>
  <depend>octomap_ros</depend>
  <build_depend>eigen3_cmake_module</build_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mapconversion</exec_depend>
  <exec_depend>rosbag2_compression_zstd</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>octomap_rviz_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
